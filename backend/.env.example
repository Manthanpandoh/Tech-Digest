# ============================================================
# TechPulse AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=TechPulse AI
DEBUG=false

# ── MongoDB Atlas ────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YOUR_APP
DATABASE_NAME=techpulse_ai
# Set USE_MOCK_DB=true to run offline in-memory tests without live Atlas access
USE_MOCK_DB=false

# ── OpenRouter (LLM Provider) ────────────────────────────────
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=google/gemini-2.5-flash

# ── LLM Tuning (optional) ────────────────────────────────────
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# ── CORS ─────────────────────────────────────────────────────
# Production: your Vercel URL, e.g. https://techpulse.vercel.app
# Multiple origins: comma-separated
FRONTEND_ORIGIN=http://localhost:5173

# ── Admin API ────────────────────────────────────────────────
# Change this to a strong random secret before deploying
ADMIN_API_KEY=change-me-in-production

# ── WhatsApp Business Cloud API ──────────────────────────────
# Set up at: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_TEMPLATE_NAME=techpulse_digest
WHATSAPP_API_VERSION=v22.0
# Keep true until credentials and templates are fully verified
WHATSAPP_DRY_RUN=true

# ── WhatsApp Recipients ───────────────────────────────────────
# Comma-separated E.164 numbers WITHOUT the + prefix
# Example: 919876543210,918765432109
WHATSAPP_RECIPIENTS=

# ── Scheduling ───────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
# Cron in UTC: 4:00 AM IST = 22:30 UTC previous day
COLLECTION_CRON=30 22 * * *
# Cron in UTC: 6:00 AM IST = 00:30 UTC
DIGEST_SEND_CRON=30 0 * * *

# ── Pipeline limits ──────────────────────────────────────────
MAX_ARTICLES_PER_FEED=20
MAX_ARTICLES_TO_ANALYZE=50
TOP_ARTICLES_FOR_DIGEST=10
